// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Define the Category model
model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique // Category name
  funds Fund[] // Relation to Fund model
}

// Define the Fund model
model Fund {
  id          Int        @id @default(autoincrement())
  scheme_code String     @unique // Unique scheme code
  scheme_name String
  categoryId  Int        // Foreign key to Category
  category    Category   @relation(fields: [categoryId], references: [id])
  navEntries  NavEntry[] // Relation to NavEntry model

  @@index([categoryId])
}

// Define the NavEntry model for time-series data
model NavEntry {
  id     Int      @id @default(autoincrement())
  date   DateTime @db.Date // Just the date part
  nav    Float
  fundId Int      // Foreign key to Fund
  fund   Fund     @relation(fields: [fundId], references: [id])

  @@index([fundId, date]) // Composite index for querying NAV by fund and date
  @@index([date])         // Index for date-based queries
}
